# ============================================================
# Toniva Cagri Denetim Botu - Railway / lokal ornek env
# Bu dosyayi kopyalayip .env yapin. GERCEK secret buraya YAZMAYIN (git'e girer).
# Railway: Variables sekmesinden ayni anahtarlari girin.
# ============================================================

# --- Zorunlu ---
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_BOTFATHER_TOKEN

# --- Onerilir (production) ---
# Virgulle ayrilmis Telegram grup basliklari (case-insensitive)
# Ornek: Dis AS Ekip,Satis,Destek,Outbound A,Outbound B,Kalite
ALLOWED_GROUP_NAMES=GrupAdi1,GrupAdi2,GrupAdi3,GrupAdi4,GrupAdi5,GrupAdi6

# SQLite (Railway volume mount /data ise asagidaki path)
DATABASE_PATH=/data/bot.sqlite3

# --- Opsiyonel (varsayilanlar yeter) ---
TONIVA_API_URL=https://crm.toniva.net/api/public/v1
TIMEZONE=Europe/Istanbul
REPORT_INTERVAL_MINUTES=60
SCHEDULER_START_TIME=11:00
SCHEDULER_END_TIME=19:00
DEPARTMENT_REPORT_DELAY_SECONDS=30
REQUEST_TIMEOUT_SECONDS=90
TONIVA_FORCE_IPV4=1

# Railway health check (platform PORT verir)
# PORT=
